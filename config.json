    "KnownHogs": [
      {
        "Name": "Ferdium",
        "Why": "Jeder Dienst = eigener Chromium-Prozess. 24 Dienste = ~2-3 GB RAM.",
        "Fix": "Dienste reduzieren oder Hibernation aggressiver (Menue 5/6)",
        "HowTo": "Ferdium oeffnen > Einstellungen > Hibernation: Hibernate on startup AN, Hibernation strategy auf 5 Min. Oder: Dienste loeschen die du nicht brauchst (Rechtsklick auf Dienst > Remove)."
      },
      {
        "Name": "chrome",
        "Why": "Viele Tabs/Erweiterungen = viele Prozesse.",
        "Fix": "Tabs schliessen, Erweiterungen pruefen",
        "HowTo": "chrome://extensions oeffnen > unnoetige Erweiterungen entfernen. Tabs schliessen oder Tab Suspender nutzen. SysPilot Menue 21 zeigt Duplikate."
      },
      {
        "Name": "msedge",
        "Why": "Edge laeuft oft im Hintergrund weiter.",
        "Fix": "Edge: Einstellungen > System > Hintergrund-Apps aus",
